+async function compressOversizedImage(inputFile, signal) {
+  const decoded = await decodeImageSource(inputFile, signal);
+  const canvas = typeof document !== "undefined" ? document.createElement("canvas") : null;
+  if (!canvas) {
+    decoded.cleanup();
+    throw new Error("Trình duyệt không tạo được bộ xử lý ảnh.");
+  }
+
+  let drawnW = 0;
+  let drawnH = 0;
+  let lowestQualityForDims = Infinity;
+
+  try {
